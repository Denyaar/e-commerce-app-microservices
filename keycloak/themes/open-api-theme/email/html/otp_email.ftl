<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Verification code | EcoCash Developer SandBox</title>
</head>
<body style="margin:0;background:#07091A;color:#EEF2FF;font-family:Arial,sans-serif;line-height:1.6;padding:32px 16px;">
<table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;">
    <tr>
        <td align="center">
            <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="max-width:560px;border-collapse:collapse;background:#0A0F28;border:1px solid #1A2248;border-radius:16px;overflow:hidden;">
                <tr>
                    <td style="padding:34px 34px 28px;background:#0A0F28;">
                        <table role="presentation" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin-bottom:28px;">
                            <tr>
                                <td style="width:42px;height:42px;border-radius:10px;background:#0052A5;color:#FFFFFF;text-align:center;font-weight:900;font-size:16px;">EC</td>
                                <td style="padding-left:12px;">
                                    <div style="font-size:15px;font-weight:900;color:#EEF2FF;">EcoCash</div>
                                    <div style="font-size:10px;font-weight:800;letter-spacing:1px;color:#E30613;text-transform:uppercase;">Developer SandBox</div>
                                </td>
                            </tr>
                        </table>
                        <h1 style="margin:0 0 10px;font-size:28px;line-height:1.2;color:#EEF2FF;">Verification code</h1>
                        <p style="margin:0;color:#8B9CC8;font-size:15px;">Use this one-time code to continue signing in.</p>
                    </td>
                </tr>
                <tr>
                    <td style="background:#FFFFFF;color:#1F2937;padding:34px;text-align:center;">
                        <div style="display:inline-block;background:#F8FAFC;border:1px solid #E5E7EB;border-radius:10px;padding:18px 28px;color:#0052A5;font-family:Monaco,Consolas,monospace;font-size:32px;font-weight:900;letter-spacing:6px;">
                            ${totp!'000000'}
                        </div>
                        <p style="margin:22px 0 0;color:#64748B;font-size:14px;">This code will only be valid for a short time. If you did not request this code, ignore this email.</p>
                    </td>
                </tr>
                <tr>
                    <td style="padding:22px 34px;color:#8B9CC8;font-size:13px;background:#0A0F28;">
                        <p style="margin:0;">This message was sent by EcoCash Developer SandBox.</p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
